<div class="p-4 sm:p-6 lg:p-8">
  <div class="mb-8">
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-bold text-gray-900">Welcome to PracticalPD</h1>
      <div class="flex items-center space-x-4">
        <.link navigate={~p"/projects/new"} class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
          Create New Project
        </.link>
        <.link navigate={~p"/projects"} class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900">
          View All Projects
        </.link>
      </div>
    </div>
  </div>

  <div class="relative">
    <div class="overflow-x-auto pb-4">
      <div class="flex space-x-6 min-w-min">
        <%= for project <- @projects do %>
          <.link navigate={~p"/projects/#{project}"} class="block w-80 flex-shrink-0">
            <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-200 h-full flex flex-col">
              <div class="p-6 flex flex-col flex-grow">
                <div class="flex items-start justify-between mb-4">
                  <h2 class="text-xl font-semibold text-gray-900 mr-2"><%= project.title %></h2>
                  <span class={[
                    "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium shrink-0 mt-1",
                    project.status == "planning" && "bg-yellow-100 text-yellow-800",
                    project.status == "in_progress" && "bg-blue-100 text-blue-800",
                    project.status == "completed" && "bg-green-100 text-green-800"
                  ]}>
                    <%= String.capitalize(project.status) %>
                  </span>
                </div>
                <p class="text-sm text-gray-500 mb-4">
                  Due: <%= Calendar.strftime(project.due_date, "%B %d, %Y") %>
                </p>
                <p class="text-gray-600 line-clamp-2 flex-grow"><%= project.description %></p>
                <div class="mt-4">
                  <div class="flex -space-x-2">
                    <%= for member <- project.team_members do %>
                      <div class="h-8 w-8 rounded-full bg-gray-200 flex items-center justify-center border-2 border-white" title={member.name}>
                        <span class="text-xs font-medium text-gray-500"><%= String.first(member.name) %></span>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </.link>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mt-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Upcoming Events</h2>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
      <%= for date <- @date_range do %>
        <div class="bg-white rounded-lg shadow-md p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">
            <%= Calendar.strftime(date, "%A, %B %d") %>
          </h3>
          <div class="space-y-4">
            <%= for event <- @events_by_date[date] do %>
              <div class="p-3 bg-gray-50 rounded-lg">
                <h4 class="font-medium text-gray-900"><%= event.title %></h4>
                <p class="text-sm text-gray-600 mt-1"><%= event.description %></p>
                <p class="text-xs text-gray-500 mt-2">
                  <%= event.project.title %>
                </p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
